datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String?  @unique
  password  String
  name      String
  role      String   @default("TEAM") // ADMIN, TEAM, SPECTATOR
  teamId    String?  @unique
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id              String          @id @default(uuid())
  name            String          @unique
  shortName       String
  ownerName       String?
  phone           String?
  address         String?
  loginUsername   String?
  loginPassword   String?
  primaryColor    String          @default("#3B82F6")
  secondaryColor  String          @default("#1E40AF")
  logoText        String
  totalPurse      Float           @default(15000) // ₹15,000 standard tournament purse
  remainingPurse  Float           @default(15000)
  maxSquadSize    Int             @default(12)    // 12 players limit
  maxOverseas     Int             @default(8)
  user            User?
  squad           TeamPlayer[]
  nominatedPlayers Player[]      @relation("BelongingTeam")
  bids            Bid[]
  wonAuctions     AuctionPlayer[] @relation("WinningTeam")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Player {
  id             String          @id @default(uuid())
  sNo            Int             @default(0) // Serial Number (e.g. 1, 2, 3...)
  name           String
  profileImage   String
  country        String          @default("India")
  isOverseas     Boolean         @default(false)
  age            Int             @default(24)
  dob            String?         // Date of birth
  place          String?         // City / Village / District
  phone          String?         // Phone / WhatsApp number
  role           String          // Batter, Bowler, All-Rounder, Wicketkeeper
  battingStyle   String          @default("Right-hand bat")
  bowlingStyle   String          @default("Right-arm medium")
  basePrice      Float           @default(100) // Starting bid: ₹100
  category       String          @default("General")
  isIcon         Boolean         @default(false)
  iconPrice      Float?          // ₹2,500 default when assigned
  matches        Int             @default(0)
  runs           Int             @default(0)
  battingAvg     Float           @default(0)
  strikeRate     Float           @default(0)
  highestScore   Int             @default(0)
  wickets        Int             @default(0)
  economy        Float           @default(0)
  bowlingAvg     Float           @default(0)
  bestBowling    String          @default("0/0")
  status         String          @default("UPCOMING") // UPCOMING, IN_AUCTION, SOLD, UNSOLD
  currentPrice   Float?
  belongingTeamName String?
  belongingTeamId String?
  belongingTeam   Team?          @relation("BelongingTeam", fields: [belongingTeamId], references: [id], onDelete: SetNull)
  teamPlayer     TeamPlayer?
  auctionPlayers AuctionPlayer[]
  bids           Bid[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([sNo])
}

model Auction {
  id                String          @id @default(uuid())
  name              String          @default("Premier Cricket Auction 2026")
  status            String          @default("IDLE") // IDLE, ACTIVE, PAUSED, COMPLETED
  currentRound      Int             @default(1)
  defaultTimerSec   Int             @default(10)
  autoSell          Boolean         @default(true)  // Auto-sell when timer reaches 0
  timerEnabled      Boolean         @default(true)  // Enable/disable bid timer
  defaultPurse      Float           @default(15000)
  defaultSquadLimit Int             @default(12)
  iconPlayerPrice   Float           @default(2500)
  defaultBasePrice  Float           @default(100)
  activePlayerId    String?
  activePlayerPrice Float?
  highestBidTeamId  String?
  timerSecondsLeft  Int?
  timerExpiresAt    DateTime?
  startedAt         DateTime?
  endedAt           DateTime?
  auctionPlayers    AuctionPlayer[]
  bids              Bid[]
  events            AuctionEvent[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model AuctionPlayer {
  id            String    @id @default(uuid())
  auctionId     String
  auction       Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status        String    @default("PENDING") // PENDING, CURRENT, SOLD, UNSOLD, SKIPPED
  round         Int       @default(1)
  orderIndex    Int       @default(0)
  basePrice     Float
  finalPrice    Float?
  winningTeamId String?
  winningTeam   Team?     @relation("WinningTeam", fields: [winningTeamId], references: [id], onDelete: SetNull)
  startedAt     DateTime?
  soldAt        DateTime?
  bids          Bid[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([auctionId, playerId, round])
}

model Bid {
  id              String         @id @default(uuid())
  auctionId       String
  auction         Auction        @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionPlayerId String?
  auctionPlayer   AuctionPlayer? @relation(fields: [auctionPlayerId], references: [id], onDelete: SetNull)
  playerId        String
  player          Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  amount          Float
  bidNumber       Int
  createdAt       DateTime       @default(now())

  @@index([auctionId, playerId])
  @@index([teamId])
}

model TeamPlayer {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId  String   @unique
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  price     Float
  isIcon    Boolean  @default(false)
  acquiredAt DateTime @default(now())

  @@index([teamId])
}

model AuctionEvent {
  id        String   @id @default(uuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  type      String   // STARTED, PAUSED, RESUMED, PLAYER_UP, BID_PLACED, TIMER_RESET, SOLD, UNSOLD, SKIPPED, RESET
  message   String
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  @@index([auctionId])
}
